# Chế độ phát triển cục bộ. Không sử dụng tài khoản HPT.
PORT=3001
# Backend đọc cấu hình Supabase ở máy chủ khi triển khai.
# Không đặt secret key dưới tên VITE_*.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy names remain accepted by server/production.ts during migration.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Chỉ dùng khi khởi tạo tài khoản; không lưu các giá trị thật trong Git.
TRUECARE_BOOTSTRAP_ADMIN_PASSWORD=
TRUECARE_BOOTSTRAP_DEMO_PASSWORD=
# Kết nối chỉ đọc tới báo cáo HPT DMS. Chỉ đặt trên môi trường tin cậy;
# không đưa thông tin đăng nhập thật vào Git hoặc biến VITE_*.
HPT_SALEOUT_BASE_URL=http://seller.hptbs.com/Default.aspx
HPT_COMPANY_CODE=
HPT_USERNAME=
HPT_PASSWORD=
